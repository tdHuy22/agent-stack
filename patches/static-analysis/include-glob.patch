--- a/skills/semgrep/scripts/run-scans.sh
+++ b/skills/semgrep/scripts/run-scans.sh
@@ -545,15 +545,17 @@
 # leaves no shell-quoting surface for a ruleset or path to escape through.
 ARGV=()
 build_argv() {
-  local config=$1 includes=$2 json=$3 sarif=$4 g
+  local config=$1 includes=$2 json=$3 sarif=$4 g globs=()
   ARGV=(semgrep)
   [ -z "$PRO" ] || ARGV+=(--pro)
   ARGV+=("$METRICS_OFF")
   ARGV+=(--max-target-bytes "$MAX_TARGET_BYTES")
   [ "$MODE" != "important-only" ] || ARGV+=("${SEVERITY_FLAGS[@]}")
-  # Unquoted on purpose: includes is a space-separated glob list and must word-split here.
-  # shellcheck disable=SC2086
-  for g in $includes; do ARGV+=("--include=$g"); done
+  # agent-stack local patch (trailofbits/skills#297): split the space-separated glob list with
+  # read. An unquoted expansion also matches each glob against the working directory, so a repo
+  # root holding setup.py turned --include=*.py into --include=setup.py and skipped the rest.
+  IFS=' ' read -r -a globs <<<"$includes"
+  for g in ${globs[@]+"${globs[@]}"}; do ARGV+=("--include=$g"); done
   # On every command including the unscoped cross-language ones: those are precisely the
   # rulesets that would otherwise read the cloned rule repositories.
   [ -z "$EXCLUDE_ARG" ] || ARGV+=("$EXCLUDE_ARG")
