# Trạng thái chạy, sao lưu, môi trường cục bộ: không đưa vào git
state/
backups/
.venv/
.cache/
.tmp/
.vet-cache/
__pycache__/
*.pyc
.DS_Store
# Kết quả eval có thể chứa nội dung phiên
evals/results/
plugin/evals/results/

# Mẫu bài viết riêng tư của người dùng; văn mẫu kinh điển (phạm vi công cộng) thì đưa vào git
plugin/skills/writing-voice/samples/*
!plugin/skills/writing-voice/samples/README.md
!plugin/skills/writing-voice/samples/kinh-dien/
vendor/
plugin/.agent-stack-home
.venv-skillspector/
# Kiểu do Claude Code tự ghi cạnh mod khi nạp
plugin/.claude-plugin/types/

# Bản HTML của báo cáo kiểm duyệt: sinh lại từ bản .md bằng `vet.py html`
vet-reports/*.html
